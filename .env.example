# Host port exposed by Docker Compose.
CRYP_PORT=9527

# Persistent host directory. It contains the database, vault metadata and all
# encrypted files; back it up as one unit.
CRYP_DATA_DIR=./data

# Published image. Change this only when using another registry or tag.
CRYP_IMAGE=lori255/cryp:latest

# Directory visible to Cryp's import/browser UI inside the container.
CRYP_SOURCE_DIR=/data

# Go runtime memory target and FFmpeg acceleration policy.
GOMEMLIMIT=256MiB
CRYP_FFMPEG_HWACCEL=auto
